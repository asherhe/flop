file(WRITE "${OUTPUT}" "#pragma once\n#include <cstddef>\nnamespace flop::render::shaders {\n")
foreach(name IN ITEMS vertex_spirv fragment_spirv vertex_dxil fragment_dxil)
  if(DEFINED ${name} AND EXISTS "${${name}}")
    file(READ "${${name}}" bytes HEX)
    string(REGEX REPLACE "(..)" "0x\\1," bytes "${bytes}")
    file(APPEND "${OUTPUT}" "inline constexpr unsigned char ${name}[] = {${bytes}};\n")
  endif()
endforeach()
file(APPEND "${OUTPUT}" "}\n")
