file(STRINGS "${INPUT}" records)
file(WRITE "${OUTPUT}" "#pragma once\n#include \"flop/render/shader_library.hpp\"\nnamespace flop::render::shaders {\n")
set(entries "")
set(index 0)
foreach(record IN LISTS records)
  string(REPLACE "|" ";" fields "${record}")
  list(GET fields 0 id)
  list(GET fields 1 stage)
  list(GET fields 2 format)
  list(GET fields 3 entrypoint)
  list(GET fields 4 path)
  list(GET fields 5 reflection)
  list(GET fields 6 resource_free)
  list(GET fields 7 dxil_reflection)
  file(READ "${reflection}" metadata)
  string(JSON uniform_count LENGTH "${metadata}" uniform_buffers)
  string(JSON sampler_count LENGTH "${metadata}" textures)
  if(resource_free AND (uniform_count GREATER 0 OR sampler_count GREATER 0))
    message(FATAL_ERROR "Shader ${id} ${stage}: RESOURCE_FREE conflicts with reflected SPIR-V resources")
  endif()
  if(format STREQUAL "dxil")
    if(dxil_reflection STREQUAL "none")
      if(NOT resource_free OR uniform_count GREATER 0 OR sampler_count GREATER 0)
        message(FATAL_ERROR "Shader ${id} ${stage}: DXIL requires independent reflection; only explicitly RESOURCE_FREE shaders are supported")
      endif()
      set(metadata "{}")
    else()
      file(READ "${dxil_reflection}" metadata)
      string(JSON resource_count LENGTH "${metadata}" resources)
      string(JSON uniform_count LENGTH "${metadata}" uniform_buffers)
      set(sampler_count 0)
      if(resource_count GREATER 0)
        math(EXPR last_resource "${resource_count} - 1")
        foreach(resource_index RANGE 0 ${last_resource})
          string(JSON kind GET "${metadata}" resources ${resource_index} type)
          if(kind STREQUAL "sampler")
            math(EXPR sampler_count "${sampler_count} + 1")
          endif()
        endforeach()
      endif()
    endif()
  endif()
  if(metadata MATCHES "\\)flop_meta\"")
    message(FATAL_ERROR "Shader ${id} ${stage}: reflection contains reserved raw-string delimiter")
  endif()
  file(READ "${path}" bytes HEX)
  string(REGEX REPLACE "(..)" "0x\\1," bytes "${bytes}")
  file(APPEND "${OUTPUT}" "inline constexpr unsigned char bytes_${index}[] = {${bytes}};\n")
  set(reflected "R\"flop_meta(${metadata})flop_meta\"")
  string(APPEND entries "{\"${id}\",\"${stage}\",\"${format}\",\"${entrypoint}\",bytes_${index},sizeof(bytes_${index}),${sampler_count},0,0,${uniform_count},${reflected}},\n")
  math(EXPR index "${index}+1")
endforeach()
file(APPEND "${OUTPUT}" "inline constexpr Entry manifest[] = {\n${entries}};\n}\n")
