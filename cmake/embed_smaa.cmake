get_filename_component(output_dir "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
file(WRITE "${OUTPUT}" "#pragma once\nnamespace flop::render::smaa {\n")
foreach(name IN ITEMS area search)
  file(READ "${INPUT_DIR}/${name}.png" bytes HEX)
  string(REGEX REPLACE "(..)" "0x\\1," bytes "${bytes}")
  file(APPEND "${OUTPUT}" "inline constexpr unsigned char ${name}[] = {${bytes}};\n")
endforeach()
file(APPEND "${OUTPUT}" "}\n")
