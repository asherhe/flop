# Validate the currently supported resource subset. Keep each backend's buffer
# sizes separately: Direct3D may include trailing padding absent from SPIR-V.
file(READ "${SPIRV}" spv)
file(READ "${DXIL}" dxil)
string(JSON spv_stage GET "${spv}" stage)
string(JSON dx_stage GET "${dxil}" stage)
if(NOT spv_stage STREQUAL dx_stage)
  message(FATAL_ERROR "Shader stage mismatch: SPIR-V ${spv_stage}, DXIL ${dx_stage}")
endif()
string(JSON texture_count LENGTH "${spv}" textures)
string(JSON buffer_count LENGTH "${spv}" uniform_buffers)
string(JSON resource_count LENGTH "${dxil}" resources)
math(EXPR expected_count "${texture_count} * 2 + ${buffer_count}")
if(NOT resource_count EQUAL expected_count)
  message(FATAL_ERROR "Shader resource count differs between SPIR-V and DXIL")
endif()

function(find_resource kind binding name output)
  set(matches 0)
  if(resource_count GREATER 0)
    math(EXPR last "${resource_count} - 1")
    foreach(i RANGE 0 ${last})
      string(JSON type GET "${dxil}" resources ${i} type)
      string(JSON slot GET "${dxil}" resources ${i} binding)
      string(JSON actual_name GET "${dxil}" resources ${i} name)
      if(type STREQUAL kind AND slot EQUAL binding AND (name STREQUAL "" OR actual_name STREQUAL name))
        math(EXPR matches "${matches} + 1")
        set(found_name "${actual_name}")
      endif()
    endforeach()
  endif()
  if(NOT matches EQUAL 1)
    message(FATAL_ERROR "DXIL ${kind} binding ${binding} name '${name}' has ${matches} matches")
  endif()
  set(${output} "${found_name}" PARENT_SCOPE)
endfunction()

if(texture_count GREATER 0)
  math(EXPR last "${texture_count} - 1")
  foreach(i RANGE 0 ${last})
    string(JSON slot GET "${spv}" textures ${i} binding)
    string(JSON name GET "${spv}" textures ${i} name)
    find_resource("texture" "${slot}" "${name}" ignored)
    find_resource("sampler" "${slot}" "" ignored)
  endforeach()
endif()

string(JSON dx_buffer_count LENGTH "${dxil}" uniform_buffers)
if(NOT dx_buffer_count EQUAL buffer_count)
  message(FATAL_ERROR "Uniform buffer count differs between SPIR-V and DXIL")
endif()
if(buffer_count GREATER 0)
  math(EXPR last "${buffer_count} - 1")
  foreach(i RANGE 0 ${last})
    string(JSON slot GET "${spv}" uniform_buffers ${i} binding)
    find_resource("uniform_buffer" "${slot}" "" dx_name)
    set(matches 0)
    math(EXPR dx_last "${dx_buffer_count} - 1")
    foreach(j RANGE 0 ${dx_last})
      string(JSON candidate GET "${dxil}" uniform_buffers ${j} name)
      if(candidate STREQUAL dx_name)
        set(dx_index ${j})
        math(EXPR matches "${matches} + 1")
      endif()
    endforeach()
    if(NOT matches EQUAL 1)
      message(FATAL_ERROR "DXIL uniform buffer '${dx_name}' missing or duplicated")
    endif()
    string(JSON members LENGTH "${spv}" uniform_buffers ${i} members)
    string(JSON dx_members LENGTH "${dxil}" uniform_buffers ${dx_index} members)
    if(NOT members EQUAL dx_members)
      message(FATAL_ERROR "Uniform member count differs for binding ${slot}")
    endif()
    if(members GREATER 0)
      math(EXPR member_last "${members} - 1")
      foreach(m RANGE 0 ${member_last})
        foreach(field IN ITEMS name type components offset size)
          string(JSON a GET "${spv}" uniform_buffers ${i} members ${m} ${field})
          string(JSON b GET "${dxil}" uniform_buffers ${dx_index} members ${m} ${field})
          if(NOT a STREQUAL b)
            message(FATAL_ERROR "Uniform binding ${slot} member ${m} ${field} differs: SPIR-V '${a}', DXIL '${b}'")
          endif()
        endforeach()
      endforeach()
    endif()
  endforeach()
endif()
