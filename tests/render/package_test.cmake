file(STRINGS "${INPUT}" records)
foreach(stage IN ITEMS vertex fragment)
  set(found_spirv 0)
  set(found_dxil 0)
  foreach(record IN LISTS records)
    string(REPLACE "|" ";" fields "${record}")
    list(GET fields 0 id)
    list(GET fields 1 record_stage)
    list(GET fields 2 format)
    if(id STREQUAL "shader:craft/sprite" AND record_stage STREQUAL stage)
      if(format STREQUAL "spirv")
        math(EXPR found_spirv "${found_spirv}+1")
        list(GET fields 5 reflection)
        file(READ "${reflection}" metadata)
        string(JSON uniforms LENGTH "${metadata}" uniform_buffers)
        string(JSON textures LENGTH "${metadata}" textures)
        if(stage STREQUAL "vertex" AND NOT uniforms EQUAL 1)
          message(FATAL_ERROR "Craft vertex uniform reflection missing")
        elseif(stage STREQUAL "fragment" AND NOT textures EQUAL 1)
          message(FATAL_ERROR "Craft fragment texture reflection missing")
        endif()
      elseif(format STREQUAL "dxil")
        math(EXPR found_dxil "${found_dxil}+1")
        list(GET fields 7 reflection)
        if(reflection STREQUAL "none" OR NOT EXISTS "${reflection}")
          message(FATAL_ERROR "Craft DXIL lacks independent reflection")
        endif()
      endif()
    endif()
  endforeach()
  if(NOT found_spirv EQUAL 1 OR (EXPECT_DXIL AND NOT found_dxil EQUAL 1) OR (NOT EXPECT_DXIL AND NOT found_dxil EQUAL 0))
    message(FATAL_ERROR "Unexpected craft ${stage} package: SPIR-V=${found_spirv}, DXIL=${found_dxil}")
  endif()
endforeach()
