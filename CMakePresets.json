{
  "version": 6,
  "configurePresets": [
    {
      "name": "tests",
      "displayName": "Tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "FLOP_BUILD_GAME": false
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": false,
        "FLOP_BUILD_GAME": true
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux / WSL (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": false,
        "FLOP_BUILD_GAME": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "tests",
      "configurePreset": "tests"
    },
    {
      "name": "test-core",
      "configurePreset": "tests",
      "targets": ["flop_core_tests"]
    },
    {
      "name": "test-app",
      "configurePreset": "tests",
      "targets": ["flop_app_tests"]
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    }
  ],
  "testPresets": [
    {
      "name": "tests",
      "configurePreset": "tests",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "test-core",
      "configurePreset": "tests",
      "filter": { "include": { "label": "^core$" } },
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "test-app",
      "configurePreset": "tests",
      "filter": { "include": { "label": "^app$" } },
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ],
  "workflowPresets": [
    {
      "name": "tests",
      "steps": [
        { "type": "configure", "name": "tests" },
        { "type": "build", "name": "tests" },
        { "type": "test", "name": "tests" }
      ]
    },
    {
      "name": "windows-debug",
      "steps": [
        { "type": "configure", "name": "windows-debug" },
        { "type": "build", "name": "windows-debug" }
      ]
    },
    {
      "name": "linux-debug",
      "steps": [
        { "type": "configure", "name": "linux-debug" },
        { "type": "build", "name": "linux-debug" }
      ]
    }
  ]
}
