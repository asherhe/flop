{
  "version": 6,
  "configurePresets": [
    {
      "name": "headless",
      "displayName": "Headless",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "FLOP_BUILD_GAME": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "headless",
      "configurePreset": "headless"
    }
  ],
  "testPresets": [
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ],
  "workflowPresets": [
    {
      "name": "headless",
      "steps": [
        { "type": "configure", "name": "headless" },
        { "type": "build", "name": "headless" },
        { "type": "test", "name": "headless" }
      ]
    }
  ]
}
